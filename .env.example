# Copy to .env and fill in real values. The .env file is gitignored.

# --- Database ---
POSTGRES_USER=marketing
POSTGRES_PASSWORD=marketing
POSTGRES_DB=marketing
DATABASE_URL=postgresql+psycopg2://marketing:marketing@db:5432/marketing

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Set to "production" on the live server. In production the backend REFUSES to
# start if JWT_SECRET / APP_ENCRYPTION_KEY / ADMIN_PASSWORD are left at their
# placeholder values, or if CORS_ORIGINS still contains localhost.
ENVIRONMENT=development
# Used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Used to derive the AES-256 key that encrypts LLM API keys in the database.
APP_ENCRYPTION_KEY=change-me-too
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Initial admin user (created on first startup) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# --- LLM provider keys (seeded encrypted into the DB on first startup) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=marketing-assets

# --- SMTP (Mailpit in dev; UI at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@marketing-platform.local

# --- Frontend ---
VITE_API_URL=http://localhost:8000
